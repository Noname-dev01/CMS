# docker-compose.prod.yml이 참조하는 환경변수 키 목록 (값은 채우지 말 것 — 이 파일은
# 예시용으로만 커밋되며, 실제 값은 .env.prod에 넣고 절대 커밋하지 않는다).
# 시크릿 값에 $, #, 공백이 포함되면 작은따옴표로 감싼다 — Compose는 따옴표 없는 값과
# 큰따옴표 값의 $를 보간 대상으로 처리한다(PLAN-prod-profile.md 결정 7).

# --- DB (db 서비스 + app 서비스가 공유) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# --- 메일(SMTP) ---
MAIL_USER=
MAIL_PASS=

# --- 앱 공개 URL (비밀번호 재설정 메일 링크 생성에 사용) ---
APP_BASE_URL=

# --- 초기 관리자 부트스트랩 (선택 입력) ---
# ACTIVE 상태의 ROLE_ADMIN 계정이 하나도 없는 빈 DB에서만 사용된다.
# 이미 관리자가 있는 정상 운영 환경에서는 비워둬도 무방하다.
# 부트스트랩 성공 후에는 이 세 값을 지우고 컨테이너를 재생성하는 것을 권장한다.
ADMIN_BOOTSTRAP_USER_ID=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=
