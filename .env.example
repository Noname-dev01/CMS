# docker-compose.prod.yml이 참조하는 환경변수 키 목록 (값은 채우지 말 것 — 이 파일은
# 예시용으로만 커밋되며, 실제 값은 .env.prod에 넣고 절대 커밋하지 않는다).
# 시크릿 값에 $, #, 공백이 포함되면 작은따옴표로 감싼다 — Compose는 따옴표 없는 값과
# 큰따옴표 값의 $를 보간 대상으로 처리한다(PLAN-prod-profile.md 결정 7).

# --- DB (db 서비스 + app 서비스가 공유) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# --- 메일(SMTP) ---
MAIL_USER=
MAIL_PASS=

# --- 메일(SMTP) socket timeout (선택 입력, 단위 ms) ---
# 비워두면 application-prod.yml/docker-compose.prod.yml의 기본값(10000/30000/30000)이 적용된다.
# 이 timeout은 socket 단계(connection/read/write)만 제한하며, DNS 조회·큐 대기·전체 작업
# deadline은 제한하지 않는다(감사 M-02, remediation-plan.md PR 5). 값은 유한한 양의 정수(ms
# 단위, 단위 문자열·소수·0·음수 금지)여야 한다 — Spring이 잘못된 값을 자동으로 거부하지
# 않으므로 배포자가 실제 적용된 값을 직접 확인해야 한다(운영 절차는 docs/deployment.md 참조).
MAIL_SMTP_CONNECTION_TIMEOUT_MS=
MAIL_SMTP_READ_TIMEOUT_MS=
MAIL_SMTP_WRITE_TIMEOUT_MS=

# --- 편집기 본문 이미지 전체 상한 (선택 입력) ---
# 비워두면 기본값(1073741824바이트=1GB / 10000개)이 적용된다. 상한 도달 시 절차는 docs/deployment.md "편집기 본문 이미지" 참조.
CMS_CONTENT_IMAGE_MAX_TOTAL_BYTES=
CMS_CONTENT_IMAGE_MAX_COUNT=

# --- 앱 공개 URL (비밀번호 재설정 메일 링크 생성에 사용) ---
APP_BASE_URL=

# --- 초기 관리자 부트스트랩 (선택 입력) ---
# ROLE_ADMIN + ACTIVE/LOCKED/PASSWORD_EXPIRED 중 하나인 계정이 하나도 없을 때만 사용된다
# (잠금·비밀번호 만료로 지금 로그인 못 하는 관리자도 "관리자 없음"과 구분 — D-01 대안 A).
# 이미 그런 관리자가 있는 정상 운영 환경에서는 비워둬도 무방하다.
# 부트스트랩 성공 후에는 이 세 값을 지우고 컨테이너를 재생성하는 것을 권장한다.
ADMIN_BOOTSTRAP_USER_ID=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=
