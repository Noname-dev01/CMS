# docker-compose.prod.yml이 참조하는 환경변수 키 목록 (값은 채우지 말 것 — 이 파일은
# 예시용으로만 커밋되며, 실제 값은 .env.prod에 넣고 절대 커밋하지 않는다).
# 시크릿 값에 $, #, 공백이 포함되면 작은따옴표로 감싼다 — Compose는 따옴표 없는 값과
# 큰따옴표 값의 $를 보간 대상으로 처리한다(PLAN-prod-profile.md 결정 7).

# --- DB (db 서비스 + app 서비스가 공유) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# --- 메일(SMTP) ---
MAIL_USER=
MAIL_PASS=

# --- 메일(SMTP) socket timeout (선택 입력, 단위 ms) ---
# 비워두면 application-prod.yml/docker-compose.prod.yml의 기본값(10000/30000/30000)이 적용된다.
# 이 timeout은 socket 단계(connection/read/write)만 제한하며, DNS 조회·큐 대기·전체 작업
# deadline은 제한하지 않는다(감사 M-02, remediation-plan.md PR 5). 값은 유한한 양의 정수(ms
# 단위, 단위 문자열·소수·0·음수 금지)여야 한다 — Spring이 잘못된 값을 자동으로 거부하지
# 않으므로 배포자가 실제 적용된 값을 직접 확인해야 한다(운영 절차는 docs/deployment.md 참조).
MAIL_SMTP_CONNECTION_TIMEOUT_MS=
MAIL_SMTP_READ_TIMEOUT_MS=
MAIL_SMTP_WRITE_TIMEOUT_MS=

# --- 편집기 본문 이미지 전체 상한 (선택 입력) ---
# 비워두면 기본값(1073741824바이트=1GB / 10000개)이 적용된다. 상한 도달 시 절차는 docs/deployment.md "편집기 본문 이미지" 참조.
CMS_CONTENT_IMAGE_MAX_TOTAL_BYTES=
CMS_CONTENT_IMAGE_MAX_COUNT=

# --- 앱 공개 URL (비밀번호 재설정 메일 링크 생성에 사용) ---
APP_BASE_URL=

# --- 초기 관리자 부트스트랩 (선택 입력) ---
# ROLE_ADMIN + ACTIVE/LOCKED/PASSWORD_EXPIRED 중 하나인 계정이 하나도 없을 때만 사용된다
# (잠금·비밀번호 변경 강제로 지금 로그인 못 하는 관리자도 "관리자 없음"과 구분 — D-01 대안 A).
# 이미 그런 관리자가 있는 정상 운영 환경에서는 비워둬도 무방하다.
# 부트스트랩 성공 후에는 이 세 값을 지우고 컨테이너를 재생성하는 것을 권장한다.
ADMIN_BOOTSTRAP_USER_ID=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=

# --- 공개 문의 폼 Cloudflare Turnstile 캡차 (선택 입력) ---
# 비워두거나 CMS_INQUIRY_TURNSTILE_ENABLED를 false로 두면 문의 기능은 "닫힘"이다(GET·POST /inquiry가 503) — 캡차 없이 제출을 받는 상태는 없다.
# 열려면 ENABLED=true와 Cloudflare 대시보드에서 발급한 실제 사이트 키·시크릿 키가 모두 필요하다(실제 키는 0x4…로 시작).
# prod 프로파일은 Cloudflare 공개 테스트 키(1x0…·2x0…·3x0…)를 기동 실패로 거부한다. 개인정보처리방침에 Cloudflare 전송 고지가 필요하다(docs/deployment.md "문의 폼").
CMS_INQUIRY_TURNSTILE_ENABLED=
CMS_INQUIRY_TURNSTILE_SITE_KEY=
CMS_INQUIRY_TURNSTILE_SECRET_KEY=

# --- 유출 비밀번호 검사 (선택 입력) ---
# 비워두면 켜진다. 비밀번호 SHA-1의 앞 5자를 api.pwnedpasswords.com으로 보내 비교한다(원문·전체 해시는 나가지 않는다).
# 망이 격리된 설치에서만 false로 둔다. 호출할 수 없으면 WARN 로그를 남기고 통과시킨다(docs/deployment.md "유출 비밀번호 검사").
CMS_PASSWORD_BREACH_CHECK_ENABLED=

# --- 2단계 인증(TOTP) 비밀값 암호화 키 (필수) ---
# Base64로 인코딩한 무작위 32바이트. 생성 예: openssl rand -base64 32
# 비어 있거나 길이가 틀리면 앱이 기동하지 않는다. 잃으면 기존 2단계 등록이 모두 무효가 된다(복구 코드·관리자 해제로 재등록).
# 바꿀 때는 아래 옛 키 설정으로 교체한다(docs/deployment.md "2단계 인증" — 키 교체).
# DB 백업과 같은 곳에 두지 않는다 — 백업이 유출돼도 2단계가 유지되게 하는 키다(docs/deployment.md "2단계 인증").
CMS_TOTP_ENCRYPTION_KEY=
# 키 교체 중에만 넣는 옛 키(선택). 기동 때 옛 키 행을 현재 키로 다시 암호화한다. 기동 로그 "TOTP 키 점검"이
# "현재 키로 복호 가능 T/T"이면 비운다(옛 키 자체는 그 키로 된 백업이 남아 있는 동안 보관). 형식이 틀리거나 현재 키와 같으면 기동 실패.
CMS_TOTP_PREVIOUS_ENCRYPTION_KEY=

# --- 패스키(WebAuthn) — 2단계 인증의 대체 수단 (선택, 비면 꺼짐) ---
# 실제 도메인·TLS가 정해진 뒤 켠다. RP_ID는 등록 가능한 도메인(예: example.com), ALLOWED_ORIGINS는 관리자 화면 주소(쉼표 목록, https만).
# 켠 뒤 RP_ID를 바꾸면 기존 패스키는 모두 쓸 수 없게 된다(docs/deployment.md "패스키").
CMS_PASSKEY_RP_ID=
CMS_PASSKEY_ALLOWED_ORIGINS=
